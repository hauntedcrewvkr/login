# Server Port (Port 80 for standard web traffic)
PORT=80

# Redis / AWS ElastiCache Endpoint (e.g. redis://your-cluster.xxxxxx.0001.aps1.cache.amazonaws.com:6379)
REDIS_URL=redis://127.0.0.1:6379

# Cryptographic JWT Secret Key (Minimum 32 characters)
JWT_SECRET=enterprise_super_secure_jwt_secret_key_minimum_32_characters_2026!
